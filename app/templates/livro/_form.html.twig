{{ form_start(form) }}
    {{ form_row(form.titulo) }}
    {{ form_row(form.editora) }}

    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.edicao) }}
        </div>

        <div class="col-md-6">
            {{ form_row(form.anoPublicacao) }}
        </div>
    </div>

    {{ form_row(form.valor) }}

    <hr class="my-4">

    <h2 class="h5 fw-semibold mb-3">
        <i class="bi bi-people me-2"></i>
        Autores
    </h2>

    {{ form_row(form.autores) }}

    <hr class="my-4">

    <h2 class="h5 fw-semibold mb-3">
        <i class="bi bi-tags me-2"></i>
            Assuntos
    </h2>

    {{ form_row(form.assuntos) }}

    <hr class="my-4">

    <div class="d-flex justify-content-end gap-2">
        <a href="{{ path('app_livro_index') }}" class="btn btn-outline-secondary">
            Cancelar
        </a>

        <button type="submit" class="btn btn-dark">
            <i class="bi bi-check-lg me-1"></i>
            {{ button_label|default('Salvar livro') }}
        </button>
    </div>

{{ form_end(form) }}

