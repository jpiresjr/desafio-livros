{% extends 'base.html.twig' %}

{% block title %}Detalhes do Livro{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-10 col-lg-8">

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <i class="bi bi-book fs-3 text-secondary"></i>

                        <div>
                            <h1 class="h5 fw-semibold mb-1">
                                Detalhes do livro
                            </h1>

                            <p class="text-muted small mb-0">
                                Informações do livro cadastrado
                            </p>

                        </div>
                    </div>

                    <hr class="mb-4">

                    <div class="table table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <tbody>
                            <tr>
                                <th scope="row" style="width: 30%">Código</th>
                                <td>{{ livro.id }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Título</th>
                                <td>{{ livro.titulo }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Editora</th>
                                <td>{{ livro.editora }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Edição</th>
                                <td>{{ livro.edicao }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Ano de Publicação</th>
                                <td>{{ livro.anoPublicacao }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Valor</th>
                                <td>
                                    R$ {{ livro.valor|number_format(2, ',', '.') }}
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">Assuntos</th>
                                <td>
                                    {% for assunto in livro.assuntos %}
                                        {{ assunto.descricao }}{{ not loop.last ? ', ' : '' }}
                                    {% else %}
                                        <span class="text-muted">
                                            Nenhum assunto associado
                                        </span>
                                    {% endfor %}
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">Autores</th>
                                <td>
                                    {% for autor in livro.autores %}
                                        {{ autor.nome }}{{ not loop.last ? ', ' : '' }}
                                    {% else %}
                                        <span class="text-muted">Nenhum autor associado</span>
                                    {% endfor %}
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
                        <a href="{{ path('app_livro_index') }}" class="btn btn-outline-secondary">
                            Voltar
                        </a>

                        <a href="{{ path('app_livro_edit', {'id': livro.id}) }}" class="btn btn-dark">
                            Editar
                        </a>

                        {{ include('livro/_delete_form.html.twig') }}
                    </div>

                </div>

            </div>

        </div>

    </div>
{% endblock %}
