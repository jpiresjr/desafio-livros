{% extends 'base.html.twig' %}

{% block title %}Editar Livro{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-10 col-lg-8">

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <i class="bi bi-pencil-square fs-3 text-secondary"></i>

                        <div>
                            <h1 class="h5 fw-semibold mb-1">Editar livro</h1>

                            <p class="text-muted small mb-0">
                                Atualize as informações e os vínculos do livro.
                            </p>
                        </div>

                    </div>

                    <hr class="mb-4">

                    {{ include ('livro/_form.html.twig', {
                        'button_label': 'Atualizar'
                    }) }}

                    <hr class="my-4">

                    <div class="d-flex justify-content-end">
                        {{ include('livro/_delete_form.html.twig') }}
                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
