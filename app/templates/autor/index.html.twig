{% extends 'base.html.twig' %}

{% block title %}Autores{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-secondary text-uppercase mb-0">
            Autores
        </h2>

        <a href="{{ path('app_autor_new') }}" class="btn btn-dark">
            <i class="bi bi-plus-lg me-2"></i>
            Novo Autor
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4 py-3" style="width: 10%;">
                            Código
                        </th>

                        <th scope="col" class="py-3">
                            Nome
                        </th>

                        <th scope="col" class="text-end pe-4 py-3" style="width: 15%;">
                            Ações
                        </th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for autor in autors %}
                        <tr>
                            <td class="ps-4">
                                {{ autor.id }}
                            </td>

                            <td>
                                {{ autor.nome }}
                            </td>

                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">

                                    <a href="{{ path('app_autor_show', {'id': autor.id}) }}"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Visualizar autor"
                                       aria-label="Visualizar autor">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a href="{{ path('app_autor_edit', {'id': autor.id}) }}"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Editar autor"
                                       aria-label="Editar autor">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                Nenhum autor cadastrado.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

            </div>
        </div>
    </div>

{% endblock %}
