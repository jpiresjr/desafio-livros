<button
    type="button"
    class="btn btn-outline-danger"
    data-bs-toggle="modal"
    data-bs-target="#modalExcluirAutor"
>
    Excluir autor
</button>

<div class="modal fade" id="modalExcluirAutor" tabindex="-1"
     aria-labelledby="modalExcluirAutorLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalExcluirAutorLabel">
                    Excluir autor?
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <div class="modal-body">
                Tem certeza que deseja excluir este autor
                <strong>{{ autor.nome }}</strong>?

                <p class="text-muted mt-2 mb-0">Esta ação não poderá ser desfeita.</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form method="post" action="{{ path('app_autor_delete', {'id': autor.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ autor.id) }}">

                    <button type="submit" class="btn btn-danger">
                        Sim, excluir autor
                    </button>
                </form>
            </div>

        </div>

    </div>

</div>
