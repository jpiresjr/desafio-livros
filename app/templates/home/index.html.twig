{% extends 'base.html.twig' %}

{% block title %}Cadastro de Livros{% endblock %}

{% block body %}

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <h1 class="h3 mb-2">
                <i class="bi bi-book-half text-dark me-2"></i>
                Sistema de Cadastro de Livros
            </h1>

            <p class="text-muted mb-0">
                Gerencie livros, autores e assuntos em um único lugar.
                Consulte também o relatório de livros agrupados por autor.
            </p>
        </div>
    </div>

    <div class="alert alert-warning mb-4" role="alert">
        Antes de cadastrar um livro, é necessário ter pelo menos um autor e um assunto cadastrado.
        Você também pode cadastrar autores e assuntos em qualquer ordem.
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="border rounded-3 p-3 h-100">
                <h3 class="h6">
                    <i class="bi bi-person-plus me-2"></i>
                    1. Cadastre os autores
                </h3>
                <p class="text-muted small">
                    Registre os autores que serão associados aos livros.
                </p>
                <a href="{{ path('app_autor_index') }}" class="btn btn-outline-dark btn-sm">
                    Acessar autores
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="border rounded-3 p-3 h-100">
                <h3 class="h6">
                    <i class="bi bi-tags me-2"></i>
                    2. Cadastre os assuntos
                </h3>
                <p class="text-muted small">
                    Registre os assuntos
                </p>
                <a href="{{ path('app_assunto_index') }}" class="btn btn-outline-dark btn-sm">
                    Acessar assuntos
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="border rounded-3 p-3 h-100">
                <h3 class="h6">
                    <i class="bi bi-journal-plus me-2"></i>
                    3. Cadastre os livros
                </h3>
                <p class="text-muted small">
                    Cadastre os livros e associe aos autores e assuntos existentes.
                </p>
                <a href="{{ path('app_livro_index') }}" class="btn btn-dark btn-sm">
                    Acessar livros
                </a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <h2 class="h5 mb-2">
                <i class="bi bi-file-earmark-bar-graph text-dark me-2"></i>
                Relatórios
            </h2>

            <p class="text-muted">
                Visualize os livros cadastrados, agrupados por autor
            </p>

            <a href="{{ path('app_relatorio_index') }}" class="btn btn-outline-dark btn-sm">
                Visualize relatório
            </a>
        </div>
    </div>
{% endblock %}
